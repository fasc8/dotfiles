{
  "version": 1,
  "idle": {
    "screensaver": 600,
    "lock": 1200
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.agents"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "io.github.rizmi.portwatch"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    }
  },
  "plugins": []
}
